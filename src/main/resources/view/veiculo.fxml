<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.unicentro.lojaveiculos.controller.VeiculoController"
            prefHeight="720.0"
            prefWidth="1100.0">

    <children>

        <Label layoutX="445" layoutY="20" text="VEÍCULOS" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <!-- PRIMEIRA LINHA -->
        <Label layoutX="40" layoutY="80" text="Marca:" />
        <TextField fx:id="txtMarca" layoutX="100" layoutY="75" prefWidth="180" />

        <Label layoutX="310" layoutY="80" text="Modelo:" />
        <TextField fx:id="txtModelo" layoutX="375" layoutY="75" prefWidth="200" />

        <Label layoutX="610" layoutY="80" text="Placa:" />
        <TextField fx:id="txtPlaca" layoutX="660" layoutY="75" prefWidth="130" />

        <Label layoutX="820" layoutY="80" text="Ano:" />
        <TextField fx:id="txtAno" layoutX="860" layoutY="75" prefWidth="100" />

        <!-- SEGUNDA LINHA -->
        <Label layoutX="40" layoutY="130" text="Cor:" />
        <TextField fx:id="txtCor" layoutX="100" layoutY="125" prefWidth="180" />

        <Label layoutX="310" layoutY="130" text="Tipo:" />
        <TextField fx:id="txtTipo" layoutX="375" layoutY="125" prefWidth="200" />

        <Label layoutX="610" layoutY="130" text="Valor:" />
        <TextField fx:id="txtValor" layoutX="660" layoutY="125" prefWidth="130" />

        <Label layoutX="820" layoutY="130" text="Status:" />
        <ComboBox fx:id="cbStatus" layoutX="875" layoutY="125" prefWidth="150" />

        <!-- ESPECIFICAÇÕES -->
        <Label layoutX="40" layoutY="180" text="Especificações:" />
        <TextArea fx:id="txtEspecificacoes" layoutX="140" layoutY="175" prefWidth="885" prefHeight="70" wrapText="true" />

        <!-- BOTÕES -->
        <Button layoutX="170" layoutY="270" prefWidth="130" text="Cadastrar" onAction="#cadastrar" />
        <Button layoutX="330" layoutY="270" prefWidth="130" text="Alterar" onAction="#alterar" />
        <Button layoutX="490" layoutY="270" prefWidth="130" text="Excluir" onAction="#excluir" />
        <Button layoutX="650" layoutY="270" prefWidth="130" text="Limpar" onAction="#limpar" />
        <Button layoutX="810" layoutY="270" prefWidth="130" text="Voltar" onAction="#voltar" />

        <!-- BARRA DE PESQUISA (DIFERENCIAL 1) -->
        <Label layoutX="25" layoutY="310" text="Buscar (Marca/Placa):" style="-fx-font-weight: bold;" />
        <TextField fx:id="txtBusca" layoutX="160" layoutY="305" prefWidth="300" promptText="Digite para filtrar..." />

        <!-- TABELA -->
        <TableView fx:id="tabelaVeiculos" layoutX="25" layoutY="345" prefWidth="1050" prefHeight="325">
            <columns>
                <TableColumn fx:id="colId" prefWidth="55" text="ID" />
                <TableColumn fx:id="colMarca" prefWidth="100" text="Marca" />
                <TableColumn fx:id="colModelo" prefWidth="150" text="Modelo" />
                <TableColumn fx:id="colPlaca" prefWidth="95" text="Placa" />
                <TableColumn fx:id="colCor" prefWidth="90" text="Cor" />
                <TableColumn fx:id="colValor" prefWidth="110" text="Valor" />
                <TableColumn fx:id="colStatus" prefWidth="110" text="Status" />
                <TableColumn fx:id="colTipo" prefWidth="100" text="Tipo" />
                <TableColumn fx:id="colAno" prefWidth="70" text="Ano" />
                <TableColumn fx:id="colEspecificacoes" prefWidth="170" text="Especificações" />
            </columns>
        </TableView>

    </children>
</AnchorPane>