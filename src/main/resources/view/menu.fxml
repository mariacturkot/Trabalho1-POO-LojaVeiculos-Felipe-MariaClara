<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.unicentro.lojaveiculos.controller.MenuController"
            prefHeight="400.0"
            prefWidth="600.0">

    <children>

        <Label
                layoutX="185.0"
                layoutY="60.0"
                text="LOJA DE VEÍCULOS"
                style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <Button
                layoutX="200.0"
                layoutY="140.0"
                prefWidth="200.0"
                prefHeight="45.0"
                text="FUNCIONÁRIOS"
                onAction="#abrirFuncionarios" />

        <Button
                layoutX="200.0"
                layoutY="210.0"
                prefWidth="200.0"
                prefHeight="45.0"
                text="VEÍCULOS"
                onAction="#abrirVeiculos" />

        <Button
                layoutX="200.0"
                layoutY="280.0"
                prefWidth="200.0"
                prefHeight="45.0"
                text="VENDAS"
                onAction="#abrirVendas" />

    </children>

</AnchorPane>