<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.unicentro.lojaveiculos.controller.VendaController"
            prefHeight="650.0"
            prefWidth="1000.0">

    <children>

        <Label
                layoutX="450"
                layoutY="25"
                text="VENDAS"
                style="-fx-font-size: 24px; -fx-font-weight: bold;" />


        <!-- FUNCIONÁRIO -->

        <Label
                layoutX="50"
                layoutY="90"
                text="Funcionário:" />

        <ComboBox
                fx:id="cbFuncionario"
                layoutX="140"
                layoutY="85"
                prefWidth="320" />


        <!-- VEÍCULO -->

        <Label
                layoutX="500"
                layoutY="90"
                text="Veículo:" />

        <ComboBox
                fx:id="cbVeiculo"
                layoutX="560"
                layoutY="85"
                prefWidth="350" />


        <!-- DATA DA VENDA -->

        <Label
                layoutX="50"
                layoutY="145"
                text="Data da venda:" />

        <DatePicker
                fx:id="dpDataVenda"
                layoutX="150"
                layoutY="140"
                prefWidth="170" />


        <!-- VALOR -->

        <Label
                layoutX="360"
                layoutY="145"
                text="Valor total:" />

        <TextField
                fx:id="txtValorTotal"
                layoutX="440"
                layoutY="140"
                prefWidth="160" />


        <!-- DATA PAGAMENTO -->

        <Label
                layoutX="640"
                layoutY="145"
                text="Data pagamento:" />

        <DatePicker
                fx:id="dpDataPagamento"
                layoutX="755"
                layoutY="140"
                prefWidth="170" />


        <!-- BOTÕES -->

        <Button
                layoutX="130"
                layoutY="210"
                prefWidth="130"
                text="Cadastrar"
                onAction="#cadastrar" />

        <Button
                layoutX="280"
                layoutY="210"
                prefWidth="130"
                text="Alterar"
                onAction="#alterar" />

        <Button
                layoutX="430"
                layoutY="210"
                prefWidth="130"
                text="Excluir"
                onAction="#excluir" />

        <Button
                layoutX="580"
                layoutY="210"
                prefWidth="130"
                text="Limpar"
                onAction="#limpar" />

        <Button
                layoutX="730"
                layoutY="210"
                prefWidth="130"
                text="Voltar"
                onAction="#voltar" />

        <!-- BOTÃO DO DIFERENCIAL 2 -->
        <Button layoutX="130"
                layoutY="245"
                prefWidth="730"
                text="Gerar Recibo de Venda"
                onAction="#gerarRecibo"
                style="-fx-font-weight: bold; -fx-text-fill: green;" />

        <!-- TABELA -->

        <TableView
                fx:id="tabelaVendas"
                layoutX="40"
                layoutY="280"
                prefWidth="920"
                prefHeight="310">

            <columns>

                <TableColumn
                        fx:id="colId"
                        prefWidth="60"
                        text="ID" />

                <TableColumn
                        fx:id="colFuncionario"
                        prefWidth="200"
                        text="Funcionário" />

                <TableColumn
                        fx:id="colVeiculo"
                        prefWidth="230"
                        text="Veículo" />

                <TableColumn
                        fx:id="colDataVenda"
                        prefWidth="130"
                        text="Data Venda" />

                <TableColumn
                        fx:id="colValorTotal"
                        prefWidth="130"
                        text="Valor Total" />

                <TableColumn
                        fx:id="colDataPagamento"
                        prefWidth="150"
                        text="Data Pagamento" />

            </columns>

        </TableView>

    </children>

</AnchorPane>